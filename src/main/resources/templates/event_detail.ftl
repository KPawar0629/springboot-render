<!doctype html>
<html lang="en">
<head>
    <title>Event Details</title>
</head>
<body>
    <button></button>
    <h1>${event.eventName}</h1>
    <p>${event.eventDescription}</p>
    <p>${event.eventLocation}</p>
    <p>${event.eventDateTime}</p>
    <p>${event.notesOnTickets}</p>
    <p>${event.lastModifiedBy}</p>
    <p>${event.lastModifiedAt}</p>
    <a href="/events/edit/${event.eventId}">Edit Event</a>
    <a href="/event_list">Back to Events List</a>
</body>
</html>


